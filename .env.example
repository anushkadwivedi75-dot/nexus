# ==============================================================================
# Nexus Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="Nexus API"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Infrastructure
POSTGRES_DB=nexus_dev
POSTGRES_USER=nexus_migrator
POSTGRES_PASSWORD=migrator_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_password

# Database Connection URLs
# Async URL for FastAPI runtime (asyncpg)
DATABASE_URL=postgresql+asyncpg://nexus_migrator:migrator_dev_password@localhost:5432/nexus_dev
# Sync URL for Alembic migration commands (psycopg / asyncpg fallback)
DATABASE_SYNC_URL=postgresql+asyncpg://nexus_migrator:migrator_dev_password@localhost:5432/nexus_dev

# Redis Connection URL
REDIS_URL=redis://:dev_redis_password@localhost:6379/0

# Frontend Development
VITE_API_BASE_URL=http://localhost:8000/api/v1

