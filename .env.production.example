# ==============================================================================
# Nexus Production Environment Configuration (.env.production)
# Reference: NEXUS_SYSTEM_BLUEPRINT_PHASE_0_v1.3.1.md Section 18 & 19
# ==============================================================================

# Application Settings
APP_NAME="Nexus"
APP_ENV=production
DEBUG=False
API_V1_STR=/api/v1
PORT=80
WEB_CONCURRENCY=2

# Security & Cryptography (Generate unique random strings for production!)
# Must be at least 32 characters long
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARACTERS_RANDOM_SECRET_KEY
# 256-bit (32 bytes) hex-encoded key for AES-256-GCM grace stash encryption (64 hex chars)
TOKEN_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS_0123456789abcdef0123456789abcdef01234567

# Allowed CORS Origins (JSON array of strings)
CORS_ORIGINS=["https://nexus.yourdomain.com"]

# PostgreSQL Production Credentials
POSTGRES_DB=nexus_prod
POSTGRES_USER=nexus_migrator
POSTGRES_PASSWORD=CHANGE_ME_STRONG_MIGRATOR_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Production Credentials
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Database Connection URLs (Auto-composed by default, override if using external DB e.g. AWS RDS)
DATABASE_URL=postgresql+asyncpg://nexus_migrator:CHANGE_ME_STRONG_MIGRATOR_DB_PASSWORD@postgres:5432/nexus_prod
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

# Run migrations automatically on container boot
RUN_MIGRATIONS=true

